# --- Local development (recommended to start) ---
# Postgres.app / Homebrew default (trust auth, your mac username, no password):
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/azimex
# Docker default (postgres/postgres):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/azimex

# --- Production (Supabase) — swap to this one line when deploying ---
# Copy the *Session pooler* string from the Supabase "Connect" button and change
# the scheme to postgresql+asyncpg://. URL-encode special chars in the password.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
ENVIRONMENT=development
